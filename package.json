{
  "name": "movie-hat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "update-version": "node src/assets/javascript/version.js",
    "backup-hats": "node scripts/backup-hats.mjs",
    "restore-hats": "node scripts/restore-hats.mjs",
    "prune-empty-hats": "node scripts/prune-empty-hats.mjs",
    "build-membership-index": "node scripts/build-membership-index.mjs",
    "generate-hat-rules": "node scripts/generate-hat-rules.mjs",
    "mint-hat-token": "node scripts/mint-hat-token.mjs",
    "serve": "nodemon --watch .env --exec \"vue-cli-service serve\"",
    "build": "vue-cli-service build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "predeploy": "node scripts/backup-hats.mjs --quiet --skip-if-fresh=6 || echo backup-skipped",
    "deploy": "node scripts/bump-and-build.mjs && aws s3 sync dist/ s3://movie-hat --delete --profile personal-deploy && aws cloudfront create-invalidation --distribution-id EBSAAKUEVN304 --paths '/*' --profile personal-deploy > invalidation_output.txt"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.2.3",
    "bootstrap-icons": "^1.10.3",
    "chart.js": "^4.3.0",
    "core-js": "^3.8.3",
    "firebase": "^10.12.4",
    "lodash": "^4.17.21",
    "ordinal-js": "^1.1.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.2.13",
    "vue-chart-3": "^3.1.8",
    "vue-router": "^4.1.6",
    "vue3-lazyload": "^0.3.6",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@eslint/js": "^9",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-pwa": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^10",
    "eslint-plugin-promise": "^7",
    "eslint-plugin-vue": "^10.10.0",
    "firebase-admin": "^12",
    "globals": "^15",
    "nodemon": "^3.1.4",
    "sass": "^1.58.0",
    "sass-loader": "^13.2.0",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
