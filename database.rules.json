{
  "rules": {
    ".read": false,
    ".write": false,
    "hats": {
      "$title": {
        "$hatKey": {
          ".read": "auth != null && auth.token.email != null && data.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists()",
          ".write": "auth != null && auth.token.email != null && ((data.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists() && (newData.exists() || (!data.child('createdBy').exists() || data.child('createdBy').val() === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')))) || (!data.exists() && newData.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists()))",
          ".validate": "!newData.exists() || newData.hasChild('memberEmails')"
        }
      }
    },
    "mirrorFeed": {
      ".read": false,
      "$title": {
        ".read": false,
        "$hatKey": {
          ".read": false,
          ".write": "auth != null && auth.token.email != null && root.child('hats').child($title).child($hatKey).child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists()",
          "$secret": {
            ".read": true
          }
        }
      }
    },
    "bugReports": {
      "$reportId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['transcript', 'createdAt']) && newData.child('transcript').isString() && newData.child('transcript').val().length <= 5000"
      }
    },
    "userHats": {
      "$memberKey": {
        ".read": "auth != null && auth.token.email != null && $memberKey === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')",
        "$entryKey": {
          ".write": "auth != null && auth.token.email != null && ($memberKey === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-') || (!data.exists() && newData.exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['title', 'hatKey'])"
        }
      }
    },
    "push": {
      "$memberKey": {
        ".read": "auth != null && auth.token.email != null && $memberKey === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')",
        ".write": "auth != null && auth.token.email != null && $memberKey === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')"
      }
    },
    "requests": {
      ".read": false,
      "$tmdbId": {
        ".read": "auth != null && auth.token.email != null",
        ".write": "auth != null && auth.token.email != null && newData.exists() && (!data.exists() || data.child('status').val() === 'error')",
        ".validate": "$tmdbId.matches(/^[1-9][0-9]{0,9}$/) && newData.hasChildren(['tmdbId', 'title', 'status', 'source', 'requestedBy', 'createdAt']) && newData.child('tmdbId').isNumber() && newData.child('title').isString() && newData.child('title').val().length <= 300 && newData.child('status').val() === 'pending' && (newData.child('source').val() === 'movie-hat' || newData.child('source').val() === 'cinema-roll') && newData.child('requestedBy').val() === auth.token.email && newData.child('createdAt').isNumber()"
      }
    }
  }
}
