{
  "rules": {
    ".read": false,
    ".write": false,
    "hats": {
      "$title": {
        "$hatKey": {
          ".read": "auth != null && auth.token.email != null && data.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists()",
          ".write": "auth != null && auth.token.email != null && (data.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists() || (!data.exists() && newData.child('memberEmails').child(auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')).exists()))",
          ".validate": "!newData.exists() || newData.hasChild('memberEmails')"
        }
      }
    },
    "userHats": {
      "$memberKey": {
        ".read": "auth != null && auth.token.email != null && $memberKey === auth.token.email.toLowerCase().replace('.', '-').replace('$', '-').replace('#', '-').replace('[', '-').replace(']', '-').replace('/', '-')",
        ".write": "auth != null && auth.token.email != null"
      }
    }
  }
}
